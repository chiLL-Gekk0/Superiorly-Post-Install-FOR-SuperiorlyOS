<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="C_Bg">#000000</Color>
    <SolidColorBrush x:Key="B_Bg" Color="{StaticResource C_Bg}" />
    <SolidColorBrush x:Key="B_WindowBorder" Color="#232329" />
    <SolidColorBrush x:Key="B_Surface" Color="#23232E" />
    <SolidColorBrush x:Key="B_Card" Color="#1E1E26" />
    <SolidColorBrush x:Key="B_CardHover" Color="#2A2A36" />
    <SolidColorBrush x:Key="B_NavHover" Color="#33333F"/>
    <SolidColorBrush x:Key="B_NavBorder" Color="#7C7C86"/>
    <SolidColorBrush x:Key="B_CardBorder" Color="#33333B" />
    <!-- checkbox outline needs 3:1 on the card, which B_CardBorder cannot reach -->
    <SolidColorBrush x:Key="B_CheckboxBorder" Color="#6E6E78" />
    <SolidColorBrush x:Key="B_TextPrimary" Color="#F5F0E8" />
    <SolidColorBrush x:Key="B_TextSecondary" Color="#B5B5BD" />
    <SolidColorBrush x:Key="B_TextOnColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="B_Accent" Color="#D91023" />
    <SolidColorBrush x:Key="B_AccentHover" Color="#E02635" />
    <SolidColorBrush x:Key="B_AccentSubtle" Color="#260A0A" />
    <SolidColorBrush x:Key="B_Update" Color="#5AA9FF" />
    <SolidColorBrush x:Key="B_UpdateHover" Color="#1E5AA8" />
    <SolidColorBrush x:Key="B_UpdateSoft" Color="#335AA9FF" />
    <SolidColorBrush x:Key="B_UpdateText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B_TitlebarHover" Color="#1E1E24" />
    <SolidColorBrush x:Key="B_SwitchOff" Color="#3A3A42" />
    <SolidColorBrush x:Key="B_Success" Color="#D91023" />
    <SolidColorBrush x:Key="B_Sidebar" Color="#101014"/>
    <SolidColorBrush x:Key="B_SidebarText" Color="#F2F2F4"/>
    <SolidColorBrush x:Key="B_HomeBand" Color="#101014"/>
    <SolidColorBrush x:Key="B_HomeBandText" Color="#F2F2F4"/>
    <SolidColorBrush x:Key="B_OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="B_Overlay" Color="#80000000"/>
    <SolidColorBrush x:Key="B_ActiveRow" Color="#1AD91023"/>
    <SolidColorBrush x:Key="B_SwitchTrack" Color="#33D91023"/>
    <SolidColorBrush x:Key="B_SwitchThumb" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="B_LogoTile" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="B_ScoreLow" Color="#F87171"/>
    <SolidColorBrush x:Key="B_ScoreMid" Color="#F59E0B"/>
    <SolidColorBrush x:Key="B_ScoreHigh" Color="#22C55E"/>
    <SolidColorBrush x:Key="B_ScoreMuted" Color="#71717A"/>

</ResourceDictionary>
