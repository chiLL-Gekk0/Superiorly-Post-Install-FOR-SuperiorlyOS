<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Superiorly Post-Install</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyTitle>Superiorly Post-Install</AssemblyTitle>
    <Product>Superiorly Post-Install</Product>
    <Company>Superiorly</Company>
    <Copyright>Copyright (c) 2026 Superiorly</Copyright>
    <Trademark>Superiorly</Trademark>
    <Description>Superiorly Post-Install. Free and open source (MIT).</Description>
    <AssemblyCopyright>Copyright (c) 2026 Superiorly (MIT)</AssemblyCopyright>
    <ApplicationManifest>..\manifests\app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />

  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\actions.json" LogicalName="Superiorly.PostInstall.data.actions.json" Condition="'$(Configuration)'!='Release'" />
    <EmbeddedResource Include="Data\tooltips.json" LogicalName="Superiorly.PostInstall.data.tooltips.json" />
    <Content Include="Data\actions.json" CopyToOutputDirectory="PreserveNewest" Link="Data\actions.json" />
    <Content Include="Data\tooltips.json" CopyToOutputDirectory="PreserveNewest" Link="Data\tooltips.json" />
    <EmbeddedResource Include="Assets\Bundle\NIP\EXPERIMENTAL-LLM-ON-RENDERS-DEF.nip" LogicalName="EXPERIMENTAL-LLM-ON-RENDERS-DEF.nip" />
    <EmbeddedResource Include="Assets\Bundle\NIP\EXPERIMENTAL-LLM-ON-RENDERS-DEF-V2.nip" LogicalName="EXPERIMENTAL-LLM-ON-RENDERS-DEF-V2.nip" />
    <EmbeddedResource Include="Assets\Bundle\NIP\EXPERIMENTAL-LLM-ON-RENDERS-DEF-PREFETCH+RTCORE-V2.nip" LogicalName="EXPERIMENTAL-LLM-ON-RENDERS-DEF-PREFETCH+RTCORE-V2.nip" />
    <EmbeddedResource Include="Assets\Bundle\NIP\EXPERIMENTAL-AGGRESSIVE-TEST.nip" LogicalName="EXPERIMENTAL-AGGRESSIVE-TEST.nip" />
    <EmbeddedResource Include="Assets\Bundle\NIP\Global-Test-Experimental.nip" LogicalName="Global-Test-Experimental.nip" />
    <EmbeddedResource Include="Assets\Bundle\NIP\Latency-Test-Experimental.nip" LogicalName="Latency-Test-Experimental.nip" />
    <EmbeddedResource Include="Assets\Bundle\NIP\KernelOS Performance v2.nip" LogicalName="KernelOS Performance v2.nip" />
    <EmbeddedResource Include="Assets\Bundle\NIP\KernelOS Performance v2.1.nip" LogicalName="KernelOS Performance v2.1.nip" />
    <EmbeddedResource Include="Assets\Bundle\NIP\KernelOS Performance v3.nip" LogicalName="KernelOS Performance v3.nip" />
    <!-- Assets\Bundle mirrors the publish layout so file: probes (%SPIBINDIR%) resolve after install;
         NIP/ is excluded because those profiles ship as embedded resources, not as loose files -->
    <Content Include="Assets\Bundle\**\*" Exclude="Assets\Bundle\NIP\**\*">
      <Link>%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\Logos\*.png" />
    <Resource Include="Assets\guest.png" />
    <Resource Include="Assets\Fonts\ClimateCrisis-1979.otf" />
  </ItemGroup>

  <!-- calver from utc date; hhmm fits win32 version fields and update parsing -->
  <Target Name="CalVerVersion" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <CalVer>$([System.DateTime]::UtcNow.ToString("yyyy.M.d.HHmm"))</CalVer>
      <Version>$(CalVer)</Version>
      <AssemblyVersion>$(CalVer)</AssemblyVersion>
      <FileVersion>$(CalVer)</FileVersion>
      <InformationalVersion>$(CalVer)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>
