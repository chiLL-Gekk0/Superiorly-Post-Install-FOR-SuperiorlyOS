                    <Border Grid.Row="0" Margin="0,0,0,6" Background="{DynamicResource B_Card}" BorderThickness="0" CornerRadius="{DynamicResource R_M}" Padding="12,10,12,10" VerticalAlignment="Center" Visibility="{Binding HasTabs, Converter={StaticResource BoolToVis}}">
                        <ListBox ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}" DisplayMemberPath="Title" Background="Transparent" BorderThickness="0" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
