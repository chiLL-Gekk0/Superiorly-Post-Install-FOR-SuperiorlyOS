                                                <Setter Property="Background" Value="{DynamicResource B_Accent}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="1" Height="32" Margin="4,0,0,0" Command="{Binding SetCornerStyleCommand}" CommandParameter="win11" Content="{Binding Win11StyleLabel}" ToolTip="{Binding RoundedLabel}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWin11Style}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource B_Accent}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding ThemeLabel}" FontSize="12" Foreground="{DynamicResource B_TextSecondary}" Margin="0,14,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Height="32" Margin="0,0,4,0" Command="{Binding SetAppThemeCommand}" CommandParameter="light" Content="{Binding LightThemeLabel}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource B_Accent}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="1" Height="32" Margin="2,0,2,0" Command="{Binding SetAppThemeCommand}" CommandParameter="dark" Content="{Binding DarkThemeLabel}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource B_Accent}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="2" Height="32" Margin="4,0,0,0" Command="{Binding SetAppThemeCommand}" CommandParameter="auto" Content="{Binding AutoThemeLabel}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OptionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAutoTheme}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource B_Accent}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Panel.ZIndex="20" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource B_Overlay}" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" UseLayoutRounding="True" SnapsToDevicePixels="True">
                <Border Background="{DynamicResource B_Surface}" BorderBrush="{DynamicResource B_CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource R_M}" Padding="22,18" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
                    <StackPanel>
                        <TextBlock Text="{Binding DownloadTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B_TextPrimary}"/>
                        <TextBlock Text="{Binding DownloadStatus}" Margin="0,6,0,14" FontSize="12" Foreground="{DynamicResource B_TextSecondary}" TextWrapping="Wrap"/>
                        <ProgressBar Value="{Binding DownloadPercent}" Maximum="100" Foreground="{DynamicResource B_Success}" BorderThickness="0">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource TipProgress}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProgressIndeterminate}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <ProgressBar Height="6" Minimum="0" Maximum="100" IsIndeterminate="True" Foreground="{DynamicResource B_Success}" Background="{DynamicResource B_SwitchTrack}" BorderThickness="0" Visibility="{Binding IsProgressIndeterminate, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding DownloadPercent, StringFormat='{}{0}%'}" HorizontalAlignment="Right" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource B_TextSecondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProgressIndeterminate}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>



            <Grid Panel.ZIndex="30" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource B_Overlay}" Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVis}}" UseLayoutRounding="True" SnapsToDevicePixels="True">
                <Border Background="{DynamicResource B_Surface}" BorderBrush="{DynamicResource B_CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource R_M}" Padding="22,18" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource B_TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding ConfirmTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B_TextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ConfirmMessage}" FontSize="12" Foreground="{DynamicResource B_TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding YesLabel}" Command="{Binding ConfirmYesCommand}" Style="{StaticResource OptionButtonSuccess}" Height="30" MinWidth="80" Margin="0,0,8,0"/>
                            <Button Content="{Binding NoLabel}" Command="{Binding ConfirmNoCommand}" Style="{StaticResource OptionButton}" Height="30" MinWidth="80"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <ItemsControl x:Name="NotificationsControl" ItemsSource="{Binding Notifications}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,36,28" Width="340" Grid.Row="1" Panel.ZIndex="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource R_M}" Padding="12,10" Margin="0,0,0,8" Opacity="1">
                        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" RenderingBias="Performance"/></Border.Effect>
                            <Border.RenderTransform>
                                <TranslateTransform X="0"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="24" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource B_TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B_TextPrimary}"/>
                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{DynamicResource B_TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" Text="{Binding FilePath}" FontSize="10" Foreground="{DynamicResource B_TextPrimary}" TextDecorations="Underline" Cursor="Hand" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding FilePath}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding FilePath}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        <TextBlock.InputBindings>
                                            <MouseBinding Gesture="LeftClick" Command="{Binding OpenPathCommand}"/>
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="2" Content="&#x2715;" Width="22" Height="22" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource B_TextSecondary}" Cursor="Hand" FontSize="10" VerticalAlignment="Top" Command="{Binding CloseCommand}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="toastClose" Background="Transparent" CornerRadius="0" Padding="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="toastClose" Property="Background" Value="{DynamicResource B_CardHover}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource B_TextPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
    </Border>
    </Window>


