<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:converters="clr-namespace:Superiorly.PostInstall.Converters"
                                         xmlns:models="clr-namespace:Superiorly.PostInstall.Models" xmlns:vm="clr-namespace:Superiorly.PostInstall.ViewModels" xmlns:controls="clr-namespace:Superiorly.PostInstall.Views.Controls" xmlns:dialogs="clr-namespace:Superiorly.PostInstall.Views.Dialogs" x:Class="Superiorly.PostInstall.Views.MainWindow" Title="{Binding AppTitle}" Icon="/Assets/guest.png" Width="960" Height="640" MinWidth="980" MinHeight="580" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource B_Bg}" FontSize="13" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto" UseLayoutRounding="True" SnapsToDevicePixels="True">        <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Resources/Converters.xaml"/>
            <ResourceDictionary Source="Resources/BaseStyles.xaml"/>
            <ResourceDictionary Source="Resources/ButtonStyles.xaml"/>
            <ResourceDictionary Source="Resources/ToggleStyles.xaml"/>
            <ResourceDictionary Source="Resources/ComboBoxStyles.xaml"/>
            <ResourceDictionary Source="Templates/CardTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
</Window.Resources>

        <Border x:Name="RootBorder" Background="{DynamicResource B_Bg}" BorderBrush="{DynamicResource B_WindowBorder}" BorderThickness="1">
        <Grid ClipToBounds="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:TitleBarControl Grid.Row="0" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource B_Sidebar}" BorderThickness="0" CornerRadius="{DynamicResource R_Sidebar}" Padding="16,14,16,14" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
                                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,6" UseLayoutRounding="True" SnapsToDevicePixels="True"/>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="{DynamicResource B_SidebarText}"/>
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                        <Setter Property="Padding" Value="14,12"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="bg" Background="Transparent" BorderThickness="0" CornerRadius="{DynamicResource R_S}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <Border x:Name="accentBar" Width="5" HorizontalAlignment="Left" CornerRadius="{DynamicResource R_S}" Background="{DynamicResource B_TextPrimary}" VerticalAlignment="Stretch" Margin="0,3,0,3" Opacity="0" Visibility="Collapsed" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource B_CardHover}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource B_TextPrimary}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource B_AccentSubtle}"/>
                                                    <Setter TargetName="accentBar" Property="Opacity" Value="1"/>
                                                    <Setter TargetName="accentBar" Property="Visibility" Value="Visible"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource B_TextPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                    </ScrollViewer>
                        <StackPanel Grid.Row="1" Margin="0,10,0,0">
                            <TextBlock Text="{Binding DisclaimerText}" FontSize="9" Foreground="{DynamicResource B_SidebarText}" Opacity="0.6" TextWrapping="Wrap" TextAlignment="Center"/>
                            <TextBlock Text="{Binding BuildStamp}" FontSize="9" Foreground="{DynamicResource B_SidebarText}" Opacity="0.6" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <controls:TabsBandControl Grid.Row="0" Margin="0,0,0,6" Visibility="{Binding HasTabs, Converter={StaticResource BoolToVis}}" />

                    <Border x:Name="CardsSurface" Grid.Row="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource B_CardBorder}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="CornerRadius" Value="{DynamicResource R_M}"/>
                                    <Setter Property="Padding" Value="0,6,0,8"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasNoActions}" Value="True"/>
                                                <Condition Binding="{Binding SelectedSection.Id}" Value="home"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Margin" Value="0,0,0,0"/>
                                            <Setter Property="Background" Value="{DynamicResource B_HomeBand}"/>
                                            <Setter Property="CornerRadius" Value="{DynamicResource R_M}"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        <Grid x:Name="CardsClipGrid">
                        <ScrollViewer x:Name="CardsScroll" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollViewer">
                                            <Grid UseLayoutRounding="True" SnapsToDevicePixels="True">
                                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                        Margin="0,0,0,0"
                                                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                        Content="{TemplateBinding Content}"/>
                                                <ScrollBar x:Name="PART_VerticalScrollBar" Orientation="Vertical"
                                                           HorizontalAlignment="Right" Width="6" Margin="0,4,1,4"
                                                           Opacity="1" IsHitTestVisible="True"
                                                           Value="{TemplateBinding VerticalOffset}"
                                                           Maximum="{TemplateBinding ScrollableHeight}"
                                                           ViewportSize="{TemplateBinding ViewportHeight}"
                                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasNoActions}" Value="True"/>
                                            <Condition Binding="{Binding SelectedSection.Id}" Value="home"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="VerticalAlignment" Value="Top"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoActions}" Value="True">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ItemsControl x:Name="CardsItemsControl" Grid.Row="0" ItemsSource="{Binding Groups}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasNoActions}" Value="True"/>
                                                <Condition Binding="{Binding SelectedSection.Id}" Value="home"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><StaticResource ResourceKey="GroupTemplate" /></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Grid.Row="1" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource B_HomeBand}" CornerRadius="{DynamicResource R_M}" MinHeight="{Binding ActualHeight, ElementName=SidebarBorder, Mode=OneWay}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasNoActions}" Value="True"/>
                                                <Condition Binding="{Binding SelectedSection.Id}" Value="home"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Left" MaxHeight="{Binding ViewportHeight, ElementName=CardsScroll, Mode=OneWay, FallbackValue=480}">
                            <StackPanel Margin="16,0,16,8">
                                <Grid HorizontalAlignment="Stretch" Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" VerticalAlignment="Center" Margin="-5,4.5,5,-1">
                                        <TextBlock Text="WELCOME" FontFamily="/Assets/Fonts/#Climate Crisis 1979" FontSize="60" FontWeight="Black"
                                                   Foreground="{DynamicResource B_HomeBandText}" TextAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="90"/>
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </Border>
                                    <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="Transparent" BorderThickness="0" CornerRadius="{DynamicResource R_M}" Padding="12,10" Margin="0,0,6,0" HorizontalAlignment="Stretch">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Border Width="150" Height="150" CornerRadius="0" Background="Transparent" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                    <Image Width="150" Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                                        <Image.Source><BitmapImage UriSource="/Assets/Logos/discord.png" DecodePixelWidth="300" CacheOption="OnLoad" CreateOptions="IgnoreColorProfile"/></Image.Source>
                                                    </Image>
                                                </Border>
                                                <TextBlock Grid.Row="1" Text="{Binding HomeDiscordDesc}" FontSize="12" Foreground="{DynamicResource B_HomeBandText}" TextAlignment="Center" Margin="0,0,0,0"/>
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                                    <Border Width="44" Background="Transparent"/>
                                                    <Button Content="{Binding HomeJoinLabel}" MinWidth="120" Height="36" Background="{DynamicResource B_Accent}" BorderBrush="{DynamicResource B_Accent}" Foreground="{DynamicResource B_OnAccent}" Style="{StaticResource HomeLinkButton}"/>
                                                    <Button Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource HomeIconButton}" ToolTip="{Binding HomeCopyLinkLabel}">
                                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" Background="Transparent" BorderThickness="0" CornerRadius="{DynamicResource R_M}" Padding="12,10" Margin="6,0,6,0" HorizontalAlignment="Stretch">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Border Width="150" Height="150" CornerRadius="0" Background="Transparent" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                    <Image Width="150" Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                                        <Image.Source><BitmapImage UriSource="/Assets/Logos/instagram.png" DecodePixelWidth="300" CacheOption="OnLoad" CreateOptions="IgnoreColorProfile"/></Image.Source>
                                                    </Image>
                                                </Border>
                                                <Button Grid.Row="2" Content="{Binding HomeFollowLabel}" Margin="0,12,0,0" HorizontalAlignment="Center" MinWidth="120" Height="36" Background="{DynamicResource B_Accent}" BorderBrush="{DynamicResource B_Accent}" Foreground="{DynamicResource B_OnAccent}" Style="{StaticResource HomeLinkButton}" Command="{Binding OpenLinkCommand}" CommandParameter="https://www.instagram.com/sebastianportella/"/>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="2" Background="Transparent" BorderThickness="0" CornerRadius="{DynamicResource R_M}" Padding="12,10" Margin="6,0,0,0" HorizontalAlignment="Stretch">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <Border Width="150" Height="150" CornerRadius="28" Background="{DynamicResource B_HomeBand}" HorizontalAlignment="Center" Margin="0,0,0,12">
                                                    <Image Width="150" Height="150" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                                        <Image.Source><BitmapImage UriSource="/Assets/Logos/github.png" DecodePixelWidth="300" CacheOption="OnLoad" CreateOptions="IgnoreColorProfile"/></Image.Source>
                                                        <Image.Clip><RectangleGeometry Rect="0,0,150,150" RadiusX="28" RadiusY="28"/></Image.Clip>
                                                    </Image>
                                                </Border>
                                                <TextBlock Grid.Row="1" Text="{Binding HomeGithubDesc}" FontSize="12" Foreground="{DynamicResource B_HomeBandText}" TextAlignment="Center" Margin="0,0,0,0"/>
                                                <Button Grid.Row="2" Content="{Binding HomeFollowLabel}" Margin="0,12,0,0" HorizontalAlignment="Center" MinWidth="120" Height="36" Background="{DynamicResource B_Accent}" BorderBrush="{DynamicResource B_Accent}" Foreground="{DynamicResource B_OnAccent}" Style="{StaticResource HomeLinkButton}" Command="{Binding OpenLinkCommand}" CommandParameter="https://github.com/chiLL-Gekk0"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                                <Viewbox Height="64" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,2,0,0">
                                    <TextBlock Text="T O S U P E R I O R L Y" FontFamily="/Assets/Fonts/#Climate Crisis 1979" FontSize="48" FontWeight="Black" Foreground="{DynamicResource B_HomeBandText}" TextAlignment="Center"/>
                                </Viewbox>
                            </StackPanel>
                            </Viewbox>
                        </Border>
                        </Grid>
                        </ScrollViewer>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>

            <dialogs:QuantumMapDialog Panel.ZIndex="30" Grid.Row="0" Grid.RowSpan="2" />

            <dialogs:SettingsDialog Panel.ZIndex="30" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" />

            <dialogs:DownloadDialog Panel.ZIndex="20" Grid.Row="0" Grid.RowSpan="2" />



            <dialogs:ConfirmDialog Panel.ZIndex="30" Grid.Row="0" Grid.RowSpan="2" />

            <ItemsControl x:Name="NotificationsControl" ItemsSource="{Binding Notifications}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,36,28" Width="340" Grid.Row="1" Panel.ZIndex="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><StaticResource ResourceKey="NotificationsTemplate" /></ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
    </Border>
    </Window>


