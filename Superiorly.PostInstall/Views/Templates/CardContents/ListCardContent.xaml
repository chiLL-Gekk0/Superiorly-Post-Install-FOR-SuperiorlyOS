<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:converters="clr-namespace:Superiorly.PostInstall.Converters" xmlns:models="clr-namespace:Superiorly.PostInstall.Models" xmlns:vm="clr-namespace:Superiorly.PostInstall.ViewModels" x:Class="Superiorly.PostInstall.Views.Templates.CardContents.ListCardContent">
<Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B_TextPrimary}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource B_TextSecondary}" Margin="0,1,0,4" TextWrapping="Wrap"/>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Button Command="{Binding LoadItemsCommand}" Height="30" MinWidth="80" Margin="0,0,8,4" Style="{DynamicResource ListLoadButton}">
                                                            <Button.Content>
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding LoadListLabel}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasItems}" Value="True">
                                                                                    <Setter Property="Text" Value="{Binding UnloadListLabel}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button.Content>
                                                        </Button>
                                                        <Button Content="{Binding ActivateLabel}" Command="{Binding ActivatePowerPlanCommand}" Height="30" MinWidth="80" Margin="0,0,8,4" Style="{DynamicResource ListActivateButton}">
                                                        </Button>
                                                        <Button Content="{Binding ImportLabel}" Command="{Binding ImportPowerPlanCommand}" Height="30" MinWidth="80" Margin="0,0,8,4" Style="{DynamicResource ListImportButton}">
                                                        </Button>
                                                        <Button Content="{Binding ExportLabel}" Command="{Binding ExportPowerPlanCommand}" Height="30" MinWidth="80" Margin="0,0,8,4" Style="{DynamicResource ListExportButton}">
                                                        </Button>
                                                        <Button Content="{Binding SelectAllLabel}" Command="{Binding SelectAllCommand}"
                                                                Height="30" MinWidth="72" Margin="0,0,8,4" Style="{DynamicResource ListSelectAllButton}">
                                                        </Button>
                                                        <Button Content="{Binding UnselectAllLabel}" Command="{Binding UnselectAllCommand}"
                                                                Height="30" MinWidth="82" Margin="0,0,8,4" Style="{DynamicResource ListUnselectAllButton}">
                                                        </Button>
                                                        <Button Content="{Binding DeleteLabel}" Command="{Binding DeletePowerPlanCommand}" Height="30" MinWidth="80" Margin="0,0,8,4" Style="{DynamicResource ListDeleteButton}">
                                                        </Button>
                                    </WrapPanel>
                                                </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="1">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="12"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                    <Border Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_CardBorder}" VerticalAlignment="Top"
                                                            BorderThickness="1" CornerRadius="{DynamicResource R_S}" Padding="8" MaxHeight="300">
                                                        <StackPanel>
                                                            <TextBlock Text="Microsoft" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource B_TextPrimary}" Margin="4,0,0,6"/>
                                                            <ListBox ItemsSource="{Binding OfficialPlansView}" Background="Transparent" BorderThickness="0"
                                                                     VirtualizingPanel.IsVirtualizing="False"
                                                                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="2,4" MinHeight="28">
                                                                            <Grid.Style><Style TargetType="Grid"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="{DynamicResource B_ActiveRow}"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                            <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource B_CardBorder}" Visibility="Collapsed"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                                                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Cursor="Hand">
                                                                                <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></CheckBox.Style>
                                                                            </CheckBox>
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                                    <TextBlock FontSize="12" Foreground="{DynamicResource B_TextPrimary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                                                        <TextBlock.Text><PriorityBinding><Binding Path="DisplayName"/><Binding Path="Name"/></PriorityBinding></TextBlock.Text>
                                                                                    </TextBlock>
                                                                                    
                                                                                </Grid>
                                                                                <TextBlock FontSize="10" Foreground="{DynamicResource B_TextSecondary}" Opacity="0.7" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Detail}"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                                <ListBox.ItemContainerStyle>
                                                                    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style>
                                                                </ListBox.ItemContainerStyle>
                                                            </ListBox>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0,8,0,0"
                                                            Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_CardBorder}" BorderThickness="1"
                                                            CornerRadius="{DynamicResource R_S}" Padding="8"
                                                            Visibility="{Binding IsPowerPlanCard, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CpuIdleCard.Title}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B_TextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource B_TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding CpuIdleCard.InfoText}" Visibility="{Binding CpuIdleCard.HasInfo, Converter={StaticResource BoolToVis}}"/>
                                                                <StackPanel Orientation="Horizontal" DataContext="{Binding CpuIdleCard}" Visibility="{Binding HasToggle, Converter={StaticResource BoolToVis}}">
                                                                    <ToggleButton Style="{DynamicResource SwitchToggle}" IsChecked="{Binding IsOn}" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Title}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding CpuIdleCard.Description}" FontSize="11" Foreground="{DynamicResource B_TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Grid.Row="0" Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_CardBorder}" VerticalAlignment="Top"
                                                            BorderThickness="1" CornerRadius="{DynamicResource R_S}" Padding="8" MaxHeight="300">
                                                        <StackPanel>
                                                            <TextBlock Text="Custom" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource B_TextPrimary}" Margin="4,0,0,6"/>
                                                            <ListBox ItemsSource="{Binding CustomPlansView}" Background="Transparent" BorderThickness="0"
                                                                     VirtualizingPanel.IsVirtualizing="False"
                                                                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="2,4" MinHeight="28">
                                                                            <Grid.Style><Style TargetType="Grid"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="{DynamicResource B_ActiveRow}"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                            <Border Width="3" HorizontalAlignment="Left" Background="{DynamicResource B_CardBorder}" Visibility="Collapsed"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style></Border>
                                                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Cursor="Hand">
                                                                                <CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></CheckBox.Style>
                                                                            </CheckBox>
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                                    <TextBlock FontSize="12" Foreground="{DynamicResource B_TextPrimary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                                                        <TextBlock.Text><PriorityBinding><Binding Path="DisplayName"/><Binding Path="Name"/></PriorityBinding></TextBlock.Text>
                                                                                    </TextBlock>
                                                                                    
                                                                                </Grid>
                                                                                <TextBlock FontSize="10" Foreground="{DynamicResource B_TextSecondary}" Opacity="0.7" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Detail}"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                                <ListBox.ItemContainerStyle>
                                                                    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style>
                                                                </ListBox.ItemContainerStyle>
                                                            </ListBox>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                                <Border Grid.Row="2" Margin="0,8,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource B_CardBorder}" BorderThickness="0,1,0,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="{Binding HasCheckedItems, Converter={StaticResource BoolToVis}}"/>
                                                            <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding IsPowerPlanCard}" Value="True">
                                                                     <Setter Property="Visibility" Value="Collapsed"/>
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
</Grid>
</UserControl>
