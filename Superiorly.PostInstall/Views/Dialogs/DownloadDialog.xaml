<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:converters="clr-namespace:Superiorly.PostInstall.Converters" xmlns:models="clr-namespace:Superiorly.PostInstall.Models" xmlns:vm="clr-namespace:Superiorly.PostInstall.ViewModels" x:Class="Superiorly.PostInstall.Views.Dialogs.DownloadDialog">
            <Grid Background="{DynamicResource B_Overlay}" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" UseLayoutRounding="True" SnapsToDevicePixels="True">
                <Border Background="{DynamicResource B_Surface}" BorderBrush="{DynamicResource B_CardBorder}" BorderThickness="1" CornerRadius="{DynamicResource R_M}" Padding="22,18" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
                    <StackPanel>
                        <TextBlock Text="{Binding DownloadTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B_TextPrimary}"/>
                        <TextBlock Text="{Binding DownloadStatus}" Margin="0,6,0,14" FontSize="12" Foreground="{DynamicResource B_TextSecondary}" TextWrapping="Wrap"/>
                        <ProgressBar Value="{Binding DownloadPercent}" Maximum="100" Style="{DynamicResource DownloadProgressStyle}" Foreground="{DynamicResource B_Success}" BorderThickness="0">
                        </ProgressBar>
                        <ProgressBar Height="6" Minimum="0" Maximum="100" IsIndeterminate="True" Foreground="{DynamicResource B_Success}" Background="{DynamicResource B_SwitchTrack}" BorderThickness="0" Visibility="{Binding IsProgressIndeterminate, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding DownloadPercent, StringFormat='{}{0}%'}" HorizontalAlignment="Right" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource B_TextSecondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProgressIndeterminate}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
</UserControl>
