<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Superiorly.PostInstall.Converters">
        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" Background="{DynamicResource B_SwitchOff}" CornerRadius="13" BorderBrush="{DynamicResource B_CardBorder}" BorderThickness="1">
                            <Border x:Name="thumb" Width="18" Height="18" Background="{DynamicResource B_SwitchThumb}" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock x:Name="thumbIcon" Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource B_TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
                                <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/></Border.Effect>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource B_Accent}"/>
                                <Setter TargetName="thumbIcon" Property="Text" Value="&#xE73E;"/>
                                <Setter TargetName="thumbIcon" Property="Foreground" Value="{DynamicResource B_Accent}"/>
                                <Setter TargetName="thumb" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="22"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="MaxWidth" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True" UseLayoutRounding="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource B_Accent}" BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="2" Margin="0,1" SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
