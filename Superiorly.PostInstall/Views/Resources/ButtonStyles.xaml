<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Superiorly.PostInstall.Converters">
        <Style x:Key="TipProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{DynamicResource B_SwitchTrack}" CornerRadius="{DynamicResource R_S}"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="{DynamicResource R_S}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource B_TextSecondary}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource B_TitlebarHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource B_TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Foreground" Value="{DynamicResource B_TextSecondary}"/>
        </Style>

        <Style x:Key="HomeLinkButton" TargetType="Button">
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource B_Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource R_S}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource B_AccentHover}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource B_AccentHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource B_Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HomeIconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource B_HomeBandText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource B_Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource B_AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

<Style x:Key="OptionButton" TargetType="Button">
        <Setter Property="MinWidth" Value="72"/>
        <!-- 40px is the Windows touch-target minimum; MinHeight lets it grow with the OS font scale -->
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Background" Value="{DynamicResource B_Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B_CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource B_TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource R_S}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource B_TextPrimary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource B_TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource B_AccentSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionButtonSuccess" TargetType="Button" BasedOn="{StaticResource OptionButton}">
            <Setter Property="Background" Value="{DynamicResource B_Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource R_S}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource B_AccentHover}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource B_AccentHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource B_AccentHover}"/>
                                <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
                        <Style x:Key="OptionButtonDanger" TargetType="Button" BasedOn="{StaticResource OptionButton}">
                            <Setter Property="BorderBrush" Value="{DynamicResource B_CardBorder}"/>
                            <Setter Property="Foreground" Value="{DynamicResource B_TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource R_S}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource B_Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource B_Accent}"/>
                                <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MaximizeCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Content" Value="&#xE922;"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectableWin10Button" TargetType="Button" BasedOn="{StaticResource OptionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWin10Style}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectableWin11Button" TargetType="Button" BasedOn="{StaticResource OptionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsWin11Style}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectableLightButton" TargetType="Button" BasedOn="{StaticResource OptionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectableDarkButton" TargetType="Button" BasedOn="{StaticResource OptionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectableAutoButton" TargetType="Button" BasedOn="{StaticResource OptionButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAutoTheme}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B_Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource B_OnAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource B_Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DownloadProgressStyle" TargetType="ProgressBar" BasedOn="{StaticResource TipProgress}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProgressIndeterminate}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ListLoadButton" TargetType="Button" BasedOn="{StaticResource OptionButton}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPowerPlanCard}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ListActivateButton" TargetType="Button" BasedOn="{StaticResource OptionButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPowerPlanCard}" Value="True"/>
                        <Condition Binding="{Binding HasCheckedItems}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ListImportButton" TargetType="Button" BasedOn="{StaticResource OptionButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPowerPlanCard}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ListExportButton" TargetType="Button" BasedOn="{StaticResource OptionButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPowerPlanCard}" Value="True"/>
                        <Condition Binding="{Binding HasCheckedItems}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ListSelectAllButton" TargetType="Button" BasedOn="{StaticResource OptionButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ListUnselectAllButton" TargetType="Button" BasedOn="{StaticResource OptionButton}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasItems}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPowerPlanCard}" Value="True"/>
                        <Condition Binding="{Binding HasCheckedItems}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ListDeleteButton" TargetType="Button" BasedOn="{StaticResource OptionButtonDanger}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsPowerPlanCard}" Value="True"/>
                        <Condition Binding="{Binding HasCheckedCustomItems}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
</ResourceDictionary>
